universe = container
container_image = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

executable = inspect_raid.sh
transfer_input_files = inspect_raid.sh

log = logs/inspect_$(Cluster)_$(Process).log
error = logs/inspect_$(Cluster)_$(Process).err
output = logs/inspect_$(Cluster)_$(Process).out

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

getenv = HF_TOKEN

request_cpus = 2
request_memory = 8GB
request_disk = 10GB

queue 1
